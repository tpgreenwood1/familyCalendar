# Copy this file to .env and fill in your values.
#
# LOCAL:  both vars point to the same local Postgres instance
# NEON:   DATABASE_URL = pooled connection (pgbouncer)
#         DIRECT_URL   = direct connection (used by prisma migrate / seed)

DATABASE_URL=""
DIRECT_URL=""

# Better Auth (DesignSpec.md Phase 2). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Sign-up gate (dev-phase safeguard, not part of DesignSpec.md): comma-separated list of
# email addresses allowed to create a new account. Sign-in for already-approved accounts is
# unaffected. Leave unset/empty to block all sign-ups.
ALLOWED_SIGNUP_EMAILS=""

# Home page weather widget (lib/weather.ts) — coordinates for the Open-Meteo API (no key
# required). Optional: defaults to London if unset, matching FamilyGroup.timezone's default.
WEATHER_LAT="51.5074"
WEATHER_LON="-0.1278"

# Photo Screensaver (DesignSpec.md §16B). Auto-provisioned when you attach a Blob store to
# the Vercel project (Storage tab); for local dev, run `vercel env pull` or copy the token
# from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""
