# Copy this file to .env and fill in your values.
#
# LOCAL:  both vars point to the same local Postgres instance
# NEON:   DATABASE_URL = pooled connection (pgbouncer)
#         DIRECT_URL   = direct connection (used by prisma migrate / seed)

DATABASE_URL=""
DIRECT_URL=""

# NextAuth.js (Auth.js) v5 signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
